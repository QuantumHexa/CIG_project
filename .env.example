# Database
# PostgreSQL (required). Local Docker: docker compose up -d
DATABASE_URL=postgresql://cig:cig_secret@localhost:5432/event_media

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Server
PORT=4000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# AWS S3 (optional — falls back to local uploads/)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# AI (optional — improves auto-tagging)
HF_API_TOKEN=
